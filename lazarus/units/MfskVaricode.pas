{ ============================================================================
  MfskVaricode.pas

  MFSK Varicode (fldigi: src/mfsk/mfskvaricode.cxx) の移植。

  PSK31 の Varicode とは別物である
  ----------------------------------------------------------------------------
  どちらも「よく使う文字ほど短い」可変長符号だが、**区切りの作り方が違う**。

      PSK31  区切りは 0 が 2 つ続くこと。符号の中に 00 は現れない
      MFSK   符号は必ず 1 で始まり **00 で終わる**。符号の内部に 001 が
             現れない。受信側は下位 3 bit が 001 になった時点を区切りとする

  fldigi の受信はこう書かれている (mfsk::recvbit)。

      datashreg = (datashreg << 1) | bit;
      if ((datashreg & 7) == 1) then c = varidec(datashreg >> 1), datashreg = 1
      (C の中括弧はここでは書けない。Pascal のコメントが閉じてしまう)

  下位 3 bit の 001 は「前の符号の終わりの 00」と「次の符号の先頭の 1」が
  並んだ形である。だから >> 1 で次の 1 を落とすと、ちょうど符号値になる。
  落とした 1 は次の文字の先頭なので datashreg = 1 として持ち越す。

  この三つ ―― 先頭が 1・末尾が 00・内部に 001 が無い ―― が揃って初めて
  符号が一意に切り出せる。表を書き写し損なうと必ずどれかが崩れるので、
  test_mfsk_varicode で 256 文字すべてについて確かめている。

  上流には表が二つある
  ----------------------------------------------------------------------------
  fldigi は同じ内容を 2 つの形で持っている。

      varicode[]     "11101011100" のようなビット文字列 (送信用)
      varidecode[]   0x75C のような数値 (受信の線形探索用)

  移植では **ビット文字列だけ**を持ち、数値は起動時に作る。二重に持つと
  片方だけ直す事故が起きる。上流の数値表とは試験で突き合わせてある
  (256 件すべて一致することを確認済み)。

  引き方
  ----------------------------------------------------------------------------
  fldigi は 256 要素を線形に走査して引く。ここでは符号値を添字とする表を
  起動時に作り、一発で引く。符号は一意なので結果は変わらない。
  ============================================================================ }
unit MfskVaricode;

{$mode objfpc}{$H+}

interface

const
  { 符号として現れうる最大値 + 1。実際の最大は 0xB7C (12 bit)。 }
  MFSKVC_TABLE_SIZE = 4096;
  { 符号なしを表す。 }
  MFSKVC_NO_CHAR = -1;

{ 文字 (0..255) を符号の文字列 ("10111000" のような 0/1 の並び) にする。
  fldigi: varienc() }
function MfskVaricodeEncode(ACh: Byte): string;

{ 符号値から文字を引く。無ければ MFSKVC_NO_CHAR。
  fldigi: varidec() }
function MfskVaricodeDecode(ASymbol: LongWord): Integer;

{ 符号値としての表。試験と診断のため。 }
function MfskVaricodeValue(ACh: Byte): LongWord;

{ 受信のシフトレジスタが 1 文字の区切りに達したか。
  fldigi: (datashreg & 7) == 1
  区切りの規則をモデム側に書き写させないために、ここに置いてある。 }
function MfskVaricodeIsBoundary(AShreg: LongWord): Boolean;

{ 区切りに達したシフトレジスタから符号値を取り出す。
  fldigi: datashreg >> 1 }
function MfskVaricodeSymbolOf(AShreg: LongWord): LongWord;

implementation

const
  { fldigi src/mfsk/mfskvaricode.cxx の varicode[] をそのまま写したもの。
    注記は // で書く ―― 中括弧の注記にすると、表に現れる中括弧の文字で
    コメントが閉じてしまう (README 32 章で踏んだ)。 }
  VARICODE: array[0..255] of string = (
    '11101011100', '11101100000', '11101101000', '11101101100',   // 0=NUL 1 2 3
    '11101110000', '11101110100', '11101111000', '11101111100',   // 4 5 6 7
    '10101000', '11110000000', '11110100000', '11110101000',   // 8=BS 9=TAB 10=LF 11
    '11110101100', '10101100', '11110110000', '11110110100',   // 12 13=CR 14 15
    '11110111000', '11110111100', '11111000000', '11111010000',   // 16 17 18 19
    '11111010100', '11111011000', '11111011100', '11111100000',   // 20 21 22 23
    '11111101000', '11111101100', '11111110000', '11111110100',   // 24 25 26 27=ESC
    '11111111000', '11111111100', '100000000000', '101000000000',   // 28 29 30 31
    '100', '111000000', '111111100', '1011011000',   // 32=SP 33=! 34=" 35=#
    '1010101000', '1010100000', '1000000000', '110111100',   // 36=$ 37=% 38=& 39='
    '111110100', '111110000', '1010110100', '111100000',   // 40=( 41=) 42=* 43=+
    '10100000', '111011000', '111010100', '111101000',   // 44=, 45=- 46=. 47=/
    '11100000', '11110000', '101000000', '101010100',   // 48=0 49=1 50=2 51=3
    '101110100', '101100000', '101101100', '110100000',   // 52=4 53=5 54=6 55=7
    '110000000', '110101100', '111101100', '111111000',   // 56=8 57=9 58=: 59=;
    '1011000000', '111011100', '1010111100', '111010000',   // 60=< 61== 62=> 63=?
    '1010000000', '10111100', '100000000', '11010100',   // 64=@ 65=A 66=B 67=C
    '11011100', '10111000', '11111000', '101010000',   // 68=D 69=E 70=F 71=G
    '101011000', '11000000', '110110100', '101111100',   // 72=H 73=I 74=J 75=K
    '11110100', '11101000', '11111100', '11010000',   // 76=L 77=M 78=N 79=O
    '11101100', '110110000', '11011000', '10110100',   // 80=P 81=Q 82=R 83=S
    '10110000', '101011100', '110101000', '101101000',   // 84=T 85=U 86=V 87=W
    '101110000', '101111000', '110111000', '1011101000',   // 88=X 89=Y 90=Z 91=[
    '1011010000', '1011101100', '1011010100', '1010110000',   // 92=\\ 93=] 94=^ 95=_
    '1010101100', '10100', '1100000', '111000',   // 96=` 97=a 98=b 99=c
    '110100', '1000', '1010000', '1011000',   // 100=d 101=e 102=f 103=g
    '110000', '11000', '10000000', '1110000',   // 104=h 105=i 106=j 107=k
    '101100', '1000000', '11100', '10000',   // 108=l 109=m 110=n 111=o
    '1010100', '1111000', '100000', '101000',   // 112=p 113=q 114=r 115=s
    '1100', '111100', '1101100', '1101000',   // 116=t 117=u 118=v 119=w
    '1110100', '1011100', '1111100', '1011011100',   // 120=x 121=y 122=z 123={
    '1010111000', '1011100000', '1011110000', '101010000000',   // 124=| 125=} 126=~ 127=DEL
    '101010100000', '101010101000', '101010101100', '101010110000',   // 128 129 130 131
    '101010110100', '101010111000', '101010111100', '101011000000',   // 132 133 134 135
    '101011010000', '101011010100', '101011011000', '101011011100',   // 136 137 138 139
    '101011100000', '101011101000', '101011101100', '101011110000',   // 140 141 142 143
    '101011110100', '101011111000', '101011111100', '101100000000',   // 144 145 146 147
    '101101000000', '101101010000', '101101010100', '101101011000',   // 148 149 150 151
    '101101011100', '101101100000', '101101101000', '101101101100',   // 152 153 154 155
    '101101110000', '101101110100', '101101111000', '101101111100',   // 156 157 158 159
    '1011110100', '1011111000', '1011111100', '1100000000',   // 160 161 162 163
    '1101000000', '1101010000', '1101010100', '1101011000',   // 164 165 166 167
    '1101011100', '1101100000', '1101101000', '1101101100',   // 168 169 170 171
    '1101110000', '1101110100', '1101111000', '1101111100',   // 172 173 174 175
    '1110000000', '1110100000', '1110101000', '1110101100',   // 176 177 178 179
    '1110110000', '1110110100', '1110111000', '1110111100',   // 180 181 182 183
    '1111000000', '1111010000', '1111010100', '1111011000',   // 184 185 186 187
    '1111011100', '1111100000', '1111101000', '1111101100',   // 188 189 190 191
    '1111110000', '1111110100', '1111111000', '1111111100',   // 192 193 194 195
    '10000000000', '10100000000', '10101000000', '10101010000',   // 196 197 198 199
    '10101010100', '10101011000', '10101011100', '10101100000',   // 200 201 202 203
    '10101101000', '10101101100', '10101110000', '10101110100',   // 204 205 206 207
    '10101111000', '10101111100', '10110000000', '10110100000',   // 208 209 210 211
    '10110101000', '10110101100', '10110110000', '10110110100',   // 212 213 214 215
    '10110111000', '10110111100', '10111000000', '10111010000',   // 216 217 218 219
    '10111010100', '10111011000', '10111011100', '10111100000',   // 220 221 222 223
    '10111101000', '10111101100', '10111110000', '10111110100',   // 224 225 226 227
    '10111111000', '10111111100', '11000000000', '11010000000',   // 228 229 230 231
    '11010100000', '11010101000', '11010101100', '11010110000',   // 232 233 234 235
    '11010110100', '11010111000', '11010111100', '11011000000',   // 236 237 238 239
    '11011010000', '11011010100', '11011011000', '11011011100',   // 240 241 242 243
    '11011100000', '11011101000', '11011101100', '11011110000',   // 244 245 246 247
    '11011110100', '11011111000', '11011111100', '11100000000',   // 248 249 250 251
    '11101000000', '11101010000', '11101010100', '11101011000'   // 252 253 254 255
  );

var
  GDecodeTab: array[0..MFSKVC_TABLE_SIZE - 1] of SmallInt;
  GValue: array[0..255] of LongWord;

function MfskVaricodeEncode(ACh: Byte): string;
begin
  Result := VARICODE[ACh];
end;

function MfskVaricodeValue(ACh: Byte): LongWord;
begin
  Result := GValue[ACh];
end;

function MfskVaricodeDecode(ASymbol: LongWord): Integer;
begin
  if ASymbol >= MFSKVC_TABLE_SIZE then
    Exit(MFSKVC_NO_CHAR);
  Result := GDecodeTab[ASymbol];
end;

function MfskVaricodeIsBoundary(AShreg: LongWord): Boolean;
begin
  Result := (AShreg and 7) = 1;
end;

function MfskVaricodeSymbolOf(AShreg: LongWord): LongWord;
begin
  Result := AShreg shr 1;
end;

procedure BuildTables;
var
  i, k: Integer;
  v: LongWord;
  s: string;
begin
  for i := 0 to MFSKVC_TABLE_SIZE - 1 do
    GDecodeTab[i] := MFSKVC_NO_CHAR;
  for i := 0 to 255 do
  begin
    s := VARICODE[i];
    v := 0;
    for k := 1 to Length(s) do
      v := (v shl 1) or LongWord(Ord(s[k]) - Ord('0'));
    GValue[i] := v;
    { 符号は一意なので、ここで衝突したら表の写し間違いである。
      黙って上書きすると片方の文字が二度と出なくなるので、先勝ちにして
      試験 (往復) が気づけるようにしておく。 }
    if GDecodeTab[v] = MFSKVC_NO_CHAR then
      GDecodeTab[v] := SmallInt(i);
  end;
end;

initialization
  BuildTables;

end.
