var
  { 符号値 -> 文字。起動時に VaricodeTab から作る。 }
  GDecode: array[0..PSKVC_TABLE_SIZE-1] of Integer;
  GValue: array[0..255] of LongWord;

function PskVaricodeEncode(ACh: Byte): string;
begin
  Result := VaricodeTab[ACh];
end;

function PskVaricodeValue(ACh: Byte): LongWord;
begin
  Result := GValue[ACh];
end;

function PskVaricodeDecode(ASymbol: LongWord): Integer;
begin
  if ASymbol >= PSKVC_TABLE_SIZE then
    Exit(PSKVC_NO_CHAR);
  Result := GDecode[ASymbol];
end;

procedure BuildTables;
var
  i, k: Integer;
  v: LongWord;
  s: string;
begin
  for i := 0 to PSKVC_TABLE_SIZE - 1 do
    GDecode[i] := PSKVC_NO_CHAR;
  for i := 0 to 255 do
  begin
    s := VaricodeTab[i];
    v := 0;
    for k := 1 to Length(s) do
      v := (v shl 1) or LongWord(Ord(s[k]) - Ord('0'));
    GValue[i] := v;
    { 表が一意であることは試験で確かめている。ここでは先勝ちにせず、
      重複したら後勝ちで潰れる (試験が落ちるので気づける)。 }
    GDecode[v] := i;
  end;
end;

initialization
  BuildTables;

end.
